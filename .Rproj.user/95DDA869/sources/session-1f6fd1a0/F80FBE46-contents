/* ===== BASE ===== */
body {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  max-width: 700px;
  margin: auto;
  padding: 40px 20px;
  background: white;
  color: #222;
  line-height: 1.8;
}

/* ===== HERO ===== */
.hero {
  text-align: center;
  margin-top: 100px;
  margin-bottom: 100px;
}

/* ===== NAME ===== */
.hero h1 {
  font-size: 42px;
  font-weight: 600;
  margin-top: 20px;
}

/* ===== SUBTITLE ===== */
.subtitle {
  font-size: 16px;
  color: #777;
  margin-top: 10px;
}

/* ===== PROFILE IMAGE ===== */
.profile-pic {
  width: 140px;
  height: 140px;
  border-radius: 6px; /* square like her site */
  object-fit: cover;
}

/* ===== BUTTON ===== */
.btn-main {
  display: inline-block;
  margin-top: 25px;
  padding: 10px 22px;
  border: 1px solid #ccc;
  color: #222;
  text-decoration: none;
  border-radius: 6px;
  font-size: 14px;
}

.btn-main:hover {
  background: #f5f5f5;
}

/* ===== HEADINGS ===== */
h2 {
  font-size: 22px;
  font-weight: 600;
  margin-top: 60px;
}

/* ===== TEXT ===== */
p {
  color: #444;
}

/* ===== LINKS ===== */
a {
  color: #222;
  text-decoration: underline;
}

/* ===== NAVBAR CLEAN ===== */
.navbar {
  border-bottom: none;
}
